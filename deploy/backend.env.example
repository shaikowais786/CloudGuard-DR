ENVIRONMENT=production
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://cloudguard_admin:REPLACE_WITH_MASTER_PASSWORD@REPLACE_WITH_RDS_ENDPOINT:5432/cloudguard
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
